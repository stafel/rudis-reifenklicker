extends: default

rules:
  line-length:
    max: 160
    level: warning
  comments-indentation: disable
  truthy:
    allowed-values: ["true", "false", "on"]
  document-start: disable
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
  brackets:
    min-spaces-inside: 0
    max-spaces-inside: 1
ignore: |
  .venv/
